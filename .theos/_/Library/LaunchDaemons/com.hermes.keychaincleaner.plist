<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.keychaincleaner</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/libexec/keychain_cleanerd</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>/var/jb/var/keychain_cleaner/trigger</string>
    </array>
    <key>RunAtLoad</key>
